{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ktoya",
  "version": "../package.json",
  "identifier": "com.sevensave.ktoya.light",
  "mainBinaryName": "Ktoya",
  "build": {
    "beforeBuildCommand": "npm run build:light-web",
    "frontendDist": "../dist/light",
    "beforeDevCommand": "npm run web -- --mode light",
    "devUrl": "http://localhost:5199"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Кто я?",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 700,
        "backgroundColor": "#0e1311",
        "backgroundThrottling": "disabled",
        "additionalBrowserArgs": "--disable-background-timer-throttling --disable-renderer-backgrounding --disable-backgrounding-occluded-windows --disable-features=msWebOOUI,msPdfOOUI"
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "category": "Family Game",
    "icon": ["../resources/icon.png", "icons/icon.ico"],
    "resources": {
      "../LICENSE": "LICENSE",
      "../resources/CREDITS.md": "CREDITS.md",
      "../resources/licenses/": "licenses/"
    },
    "macOS": {
      "minimumSystemVersion": "14.0",
      "signingIdentity": "-"
    }
  }
}
